# Skopiuj do .env.local (lokalnie) albo wklej te same klucze w Vercel → Project → Settings → Environment Variables.
# Nigdy nie commituj prawdziwych sekretów.

# --- Wymagane: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Publiczny URL aplikacji (Vercel: https://twoja-domena.vercel.app albo własna domena).
# Używany w mailach zaproszeń i linkach auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mail (Resend) ---
RESEND_API_KEY=re_xxxxxxxx

# --- Webhook Google Forms (rekrutacja) ---
# Wymagane na Production (Vercel). Ten sam sekret w Apps Script (x-webhook-secret).
# Bez tej zmiennej endpoint przyjmuje każde żądanie.
GOOGLE_FORMS_WEBHOOK_SECRET=long-random-string

# --- Google Drive (service account) ---
# PRIVATE_KEY: w Vercel wklej cały klucz w jednej linii z dosłownymi \n (albo wieloliniowo w UI).
GOOGLE_DRIVE_CLIENT_EMAIL=you@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_TEACHERS_FOLDER_ID=your_teachers_folder_id
# Folder Faktury albo ID Dysku współdzielonego (zaczyna się od 0A…)
GOOGLE_DRIVE_INVOICES_FOLDER_ID=your_invoices_folder_or_shared_drive_id

# Opcjonalnie: folder „byli pracownicy” (jeśli puste - tworzony automatycznie)
# GOOGLE_DRIVE_FORMER_TEACHERS_FOLDER_ID=

# Opcjonalnie: bezpośrednie Postgres (nie używane przez aplikację Next dziś)
# DATABASE_URL=postgresql://...
